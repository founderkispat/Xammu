{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xammu.local/schemas/xammu-publication-v1.schema.json",
  "title": "XAMMU publication envelope",
  "description": "One signed delivery: the machine documents, the report and the bilingual annexes, committed to the sealed bundle and the policy that produced the verdict. The signature covers sha256(canonical-json(publication minus signature_base64, public_key_base64 and signer_key_id)).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "created_at",
    "source",
    "policy_sha256",
    "verdict",
    "exit_code",
    "files",
    "algorithm",
    "signer_key_id",
    "public_key_base64",
    "signature_base64",
    "signing_rule"
  ],
  "properties": {
    "schema_version": { "const": "xammu.publication/v1" },
    "tool_version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "policy_sha256": { "$ref": "#/$defs/digest" },
    "verdict": { "enum": ["pass", "fail"] },
    "exit_code": { "enum": [0, 1] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "algorithm": { "const": "ed25519" },
    "signer_key_id": { "type": "string", "minLength": 1 },
    "public_key_base64": { "type": "string", "minLength": 1 },
    "signature_base64": { "type": "string", "minLength": 1 },
    "signing_rule": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "bundle",
        "manifest_sha256",
        "manifest_signer_key_id",
        "manifest_signature_valid",
        "manifest_signer_anchored"
      ],
      "properties": {
        "kind": { "enum": ["effectiveness", "profiling"] },
        "run_id": { "type": "string", "minLength": 1 },
        "bundle": { "type": "string" },
        "manifest_sha256": { "$ref": "#/$defs/digest" },
        "manifest_signer_key_id": { "type": "string" },
        "manifest_signature_valid": { "type": "boolean" },
        "manifest_signer_anchored": { "type": "boolean" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
